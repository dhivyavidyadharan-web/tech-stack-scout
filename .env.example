# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The service-role key is used ONLY in server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://amflorursoqwcngkrqer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini Flash (all in-app AI) ─────────────────────────────────────
# https://aistudio.google.com/apikey — optional: without it a deterministic template is used.
GEMINI_API_KEY=
# Optional override. Defaults to the rolling "gemini-flash-latest" alias.
GEMINI_MODEL=gemini-flash-latest
# Optional: custom gateway URL if your key provider routes through a proxy.
GEMINI_BASE_URL=
# Optional: "true" for Vertex AI express-mode API keys.
GEMINI_USE_VERTEX=false

# ── GitHub ──────────────────────────────────────────────────────────────────
# Fine-grained token with "Public repositories (read-only)". Raises limit 60 → 5,000 req/hr.
GITHUB_TOKEN=

# ── Vercel Cron ─────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it as a Bearer token.
CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Enables HTTP Basic Auth on the dashboard + API (any username, this password).
DASHBOARD_PASSWORD=
# What you sell — every outreach hook is tailored to this.
SELLER_PRODUCT_DESCRIPTION=a developer productivity platform that cuts CI build times, speeds up code review and reduces context-switching for engineering teams
